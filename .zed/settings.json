{
  "languages": {
    "C++": {
      "format_on_save": "on",
      "formatter": ["prettier"],
      "tab_size": 4,
    },
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "clangd",
        "arguments": [
          "--background-index",
          "--clang-tidy",
          "--completion-style=detailed",
          "--header-insertion=iwyu",
        ],
      },
    },
  },
  "terminal": { "working_directory": "current_project_directory" },
}
